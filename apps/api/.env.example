# Local development only. Copy to .env; never use these credentials in production.
NODE_ENV=development
PUBLIC_BOOKING_ENABLED=false
DATABASE_URL=postgresql://service:local-development-only@127.0.0.1:54329/service_ilyxa_dev
TEST_DATABASE_URL=postgresql://service:local-development-only@127.0.0.1:54329/service_ilyxa_test
PORT=3008
PUBLIC_ORIGIN=http://127.0.0.1:3007
# Kazan timezone; policy values initialize PostgreSQL once on migration 4.
# Edit policy through the owner's /settings menu afterward.
SERVICE_TIMEZONE=Europe/Moscow
BOOKING_NOTICE_MINUTES=60
BOOKING_HORIZON_DAYS=30
INTAKE_WINDOW_MINUTES=30
CONSENT_VERSION=development-only
CONSENT_NOTICE_URL=http://127.0.0.1:3007/development-consent-not-published
# Owner identity supplied by the user; never grant access by username.
OWNER_TELEGRAM_IDS=733375528
# Bot settings belong only to NestJS. Enable after configuring a dedicated bot.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ilyxa_service_bot
TELEGRAM_WEBHOOK_SECRET=
# Approved real contacts only; leave blank until supplied by the owner.
SERVICE_PHONE=
SERVICE_ADDRESS=
SERVICE_DIRECTIONS_URL=
